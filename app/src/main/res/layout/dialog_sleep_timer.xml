<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Time / Tracks segmented toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip"
        android:padding="3dp">

        <TextView
            android:id="@+id/timeTabBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Time"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_tab_selected"
            android:textColor="@color/accent_ink"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/trackTabBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Tracks"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_tab_unselected"
            android:textColor="@color/text_dim"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Time presets -->
    <LinearLayout
        android:id="@+id/timeOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/timeChipGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="4"
            app:alignmentMode="alignMargins" />

        <LinearLayout
            android:id="@+id/customTimeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/customTimeInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Custom minutes"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:backgroundTint="@color/accent"
                android:maxLength="4" />

            <Button
                android:id="@+id/customTimeSetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Set"
                android:textColor="@color/accent_ink"
                android:backgroundTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Track-count presets -->
    <LinearLayout
        android:id="@+id/trackOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/trackChipGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="4"
            app:alignmentMode="alignMargins" />

        <LinearLayout
            android:id="@+id/customTrackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/customTrackInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="Custom track count"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:backgroundTint="@color/accent"
                android:maxLength="3" />

            <Button
                android:id="@+id/customTrackSetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Set"
                android:textColor="@color/accent_ink"
                android:backgroundTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
