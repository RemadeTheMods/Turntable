<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURNTABLE"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="plays on, no matter what you're doing"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Add music"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/hairline"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Deck -->
    <LinearLayout
        android:id="@+id/deck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="182dp"
            android:layout_height="168dp"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="bottom|start">

                <ImageView
                    android:id="@+id/record"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_record"
                    android:contentDescription="Record" />

                <TextView
                    android:id="@+id/recordInitial"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_record_label"
                    android:gravity="center"
                    android:text="–"
                    android:textColor="@color/accent_ink"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textSize="15sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/tonearm"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_tonearm"
                android:rotation="-38"
                android:transformPivotX="54.6dp"
                android:transformPivotY="14dp"
                android:contentDescription="Tonearm" />
        </FrameLayout>

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nothing loaded"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="17sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/trackSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Add some music to get started"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <ImageButton
                android:id="@+id/shuffleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_shuffle_button"
                android:src="@drawable/ic_shuffle"
                android:padding="12dp"
                android:contentDescription="Shuffle" />

            <ImageButton
                android:id="@+id/prevBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_ctrl_button"
                android:src="@drawable/ic_prev"
                android:padding="11dp"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/playBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_main_button"
                android:src="@drawable/ic_play"
                android:padding="17dp"
                android:contentDescription="Play or pause" />

            <ImageButton
                android:id="@+id/nextBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_ctrl_button"
                android:src="@drawable/ic_next"
                android:padding="11dp"
                android:contentDescription="Next" />

            <ImageButton
                android:id="@+id/repeatBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_shuffle_button"
                android:src="@drawable/ic_repeat"
                android:padding="12dp"
                android:contentDescription="Repeat mode" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_add"
                android:alpha="0"
                android:contentDescription="" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="80"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />
        </LinearLayout>

        <!-- Collapsed by default to keep the main screen clean — tap the -->
        <!-- arrow to reveal Lyrics / Sleep Timer / Bluetooth. -->
        <ImageButton
            android:id="@+id/expandControlsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ctrl_button"
            android:src="@drawable/ic_chevron_down"
            android:padding="8dp"
            android:contentDescription="Show more controls" />

        <LinearLayout
            android:id="@+id/extraControlsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/lyricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lyrics"
                    android:contentDescription="Lyrics" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Lyrics"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/timerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="Sleep timer" />

                <TextView
                    android:id="@+id/timerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Timer"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bluetoothBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_bluetooth"
                    android:contentDescription="Bluetooth settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Bluetooth"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/listDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/hairline"
        app:layout_constraintTop_toBottomOf="@id/deck"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/sideHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/listDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIDE A"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/trackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nothing here yet — tap &quot;Add music&quot; to choose MP3, FLAC, MP4, WAV, OGG or AAC files from your phone."
        android:textColor="@color/text_dim"
        android:textSize="12.5sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/sideHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/sideHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Full-screen lyrics takeover. Hidden by default; slides up over        -->
    <!-- everything (including the turntable) when the person opens lyrics,   -->
    <!-- leaving only the timeline and transport buttons visible below it.    -->
    <FrameLayout
        android:id="@+id/lyricsOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- top row: collapse back to turntable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <ImageButton
                    android:id="@+id/lyricsBackBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ctrl_button"
                    android:src="@drawable/ic_chevron_down"
                    android:padding="10dp"
                    android:contentDescription="Back to turntable" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lyricsTrackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lyrics"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lyricsSyncStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_dim"
                        android:textSize="10.5sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- lyrics list, fills all remaining space -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lyricsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/lyricsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:text="Looking for lyrics…"
                    android:textColor="@color/text_dim"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/resyncBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_resync_button"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_resync"
                        android:contentDescription="Re-sync" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Re-sync"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- bottom: timeline + transport, the only other thing visible -->
            <!-- while lyrics are showing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/lyricsTimeCurrent"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <SeekBar
                        android:id="@+id/lyricsSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/lyricsTimeTotal"
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <ImageButton
                        android:id="@+id/lyricsPrevBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ctrl_button"
                        android:src="@drawable/ic_prev"
                        android:padding="11dp"
                        android:contentDescription="Previous" />

                    <ImageButton
                        android:id="@+id/lyricsPlayBtn"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_main_button"
                        android:src="@drawable/ic_play"
                        android:padding="17dp"
                        android:contentDescription="Play or pause" />

                    <ImageButton
                        android:id="@+id/lyricsNextBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_ctrl_button"
                        android:src="@drawable/ic_next"
                        android:padding="11dp"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
